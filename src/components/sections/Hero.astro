---
import Icon from '../Icon.astro';
---

<section id="top" class="hero">
  <img src="/assets/isotipo-oro.svg" alt="" aria-hidden="true" class="hero__mark" />
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="hero__in">
    <div class="hero__eyebrow">
      <span class="hero__rule" aria-hidden="true"></span>
      <span>Gobierno · Riesgo · Educación ejecutiva</span>
    </div>

    {/* En una sola línea a propósito: Astro colapsa el salto de línea entre
        texto y elemento inline, y "en" quedaba pegado a "decisiones". */}
    <h1 class="hero__h1">Convierto gobierno, riesgo y tecnología en <span class="hero__em">decisiones defendibles</span> de directorio.</h1>

    <p class="hero__lead">
      Acompaño a directorios, comités y alta gerencia a ordenar lo complejo:
      marcos, exposición, madurez y criterio. Sin ruido. Con evidencia.
    </p>

    <div class="hero__cta">
      <a href="#contacto" class="btn btn--gold">
        Agendar conversación <Icon name="arrowRight" size={19} />
      </a>
      <a href="#servicios" class="btn btn--ghost">Ver servicios</a>
    </div>

    <div class="hero__trust">
      <div>
        <div class="hero__ta">ISO 31000 · 22301 · 27001</div>
        <div class="hero__tb">Marcos de gestión</div>
      </div>
      <div>
        <div class="hero__ta">COBIT 2019 · NIST CSF · COSO ERM</div>
        <div class="hero__tb">Gobierno y control</div>
      </div>
      <div>
        <div class="hero__ta">IBEE</div>
        <div class="hero__tb">Formación ejecutiva</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--navy-900);
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, .08);
  }
  .hero__mark {
    position: absolute;
    right: -4%;
    bottom: -14%;
    height: 620px;
    opacity: .06;
    pointer-events: none;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .03) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(120% 90% at 70% 10%, #000 30%, transparent 75%);
    mask-image: radial-gradient(120% 90% at 70% 10%, #000 30%, transparent 75%);
  }
  .hero__in {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 210px 64px 150px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 30px;
    font: 700 14px/1 var(--font-ui);
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .62);
  }
  .hero__rule { width: 56px; height: 4px; background: var(--gold-500); flex: none; }

  .hero__h1 {
    font: 800 72px/1.04 var(--font-display);
    letter-spacing: -.02em;
    color: #fff;
    margin: 0;
    max-width: 940px;
  }
  .hero__em { color: var(--gold-500); }

  .hero__lead {
    font: 400 22px/1.6 var(--font-serif);
    color: rgba(255, 255, 255, .78);
    max-width: 720px;
    margin: 30px 0 0;
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 44px; }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 44px;
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, .10);
  }
  .hero__ta { font: 700 16px/1.3 var(--font-ui); color: #fff; }
  .hero__tb { font: 400 14px/1.3 var(--font-ui); color: rgba(255, 255, 255, .55); margin-top: 5px; }

  @media (max-width: 1024px) {
    .hero__in { padding: 170px 48px 110px; }
    .hero__mark { right: -12%; }
    .hero__h1 { font-size: 58px; }
  }
  @media (max-width: 720px) {
    .hero__in { padding: 140px 24px 88px; }
    .hero__mark { height: 360px; }
    .hero__h1 { font-size: 40px; }
    .hero__lead { font-size: 19px; }
    .hero__trust { gap: 20px; margin-top: 56px; }
  }
</style>
