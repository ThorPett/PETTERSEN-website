---
import Kicker from '../Kicker.astro';

/**
 * Método — matriz 5×5 con el semáforo MAP/PETTERSEN.
 *
 * Versión estática: la matriz del design system es interactiva (React), acá
 * se renderiza completa en HTML y la tabla de riesgos queda siempre visible.
 * El mensaje —«así se ve una exposición ordenada»— no depende de un clic, y
 * el sitio no envía JavaScript de framework.
 *
 * El semáforo y la grilla de niveles son los del DS (components/risk.md).
 * INVIOLABLE: no alterar colores ni bandas. El color nunca decide solo:
 * cada celda y cada riesgo llevan código de nivel.
 *
 * PENDIENTE DE MARIO: los seis riesgos son los de demostración del template.
 * Revisarlos antes de publicar.
 */

const GRID_MAP = [
  ['M', 'A', 'A', 'C', 'C'],
  ['B', 'M', 'A', 'A', 'C'],
  ['B', 'M', 'M', 'A', 'A'],
  ['MB', 'B', 'M', 'M', 'A'],
  ['MB', 'MB', 'B', 'B', 'M'],
] as const;

const LVL_LABEL = {
  MB: 'Muy bajo', B: 'Bajo', M: 'Medio', A: 'Alto', C: 'Crítico',
} as const;

type Lvl = keyof typeof LVL_LABEL;

const levelAt = (prob: number, impact: number): Lvl =>
  GRID_MAP[5 - prob][impact - 1] as Lvl;

const riesgos = [
  { id: 'R1', name: 'Ciberataque a sistemas críticos', prob: 4, impact: 5, decision: 'Tratar: mitigación prioritaria, plan a 90 días' },
  { id: 'R2', name: 'Fuga de datos personales', prob: 4, impact: 4, decision: 'Tratar: control inmediato y notificación' },
  { id: 'R3', name: 'Indisponibilidad de proveedor TI', prob: 3, impact: 4, decision: 'Transferir: cláusula SLA y contingencia' },
  { id: 'R4', name: 'Incumplimiento regulatorio (DORA)', prob: 2, impact: 5, decision: 'Tratar: cierre de brechas con evidencia' },
  { id: 'R5', name: 'Obsolescencia de arquitectura', prob: 3, impact: 3, decision: 'Monitorear: hoja de ruta de modernización' },
  { id: 'R6', name: 'Rotación de talento clave', prob: 3, impact: 2, decision: 'Monitorear: plan de sucesión' },
];

const filas = [5, 4, 3, 2, 1];
const cols = [1, 2, 3, 4, 5];
const at = (p: number, i: number) => riesgos.filter((r) => r.prob === p && r.impact === i);
---

<section id="matriz" class="sec sec--navy950">
  <div class="sec__in">
    <div style="max-width:720px">
      <Kicker onDark>Método</Kicker>
      <h2 class="h2 h2--dark">Así se ve una exposición ordenada.</h2>
      <p class="lead lead--dark">
        Probabilidad por impacto, con semáforo de riesgo. El color nunca decide solo:
        cada riesgo lleva código de nivel y una decisión asociada.
      </p>
    </div>

    <figure class="mx">
      <figcaption class="mx__cap">
        <span class="mx__title">Exposición de riesgos · vista de comité</span>
        <span class="mx__sub">6 riesgos priorizados · código de nivel por riesgo</span>
      </figcaption>

      <div class="mx__wrap">
        <div class="mx__yaxis" aria-hidden="true">Probabilidad</div>
        <div class="mx__grid">
          {filas.map((p) => (
            <>
              <div class="mx__ylab">{p}</div>
              {cols.map((i) => {
                const lvl = levelAt(p, i);
                const rs = at(p, i);
                return (
                  <div class={`mx__cell mx__cell--${lvl}`}>
                    <span class="mx__code">{lvl}</span>
                    {rs.length > 0 && (
                      <span class="mx__chips">
                        {rs.map((r) => <b class="mx__chip">{r.id}</b>)}
                      </span>
                    )}
                    <span class="vh">
                      Probabilidad {p}, impacto {i}. Nivel {LVL_LABEL[lvl]}.
                      {rs.length > 0 && ` Riesgos: ${rs.map((r) => r.id).join(', ')}.`}
                    </span>
                  </div>
                );
              })}
            </>
          ))}
          <div></div>
          {cols.map((i) => <div class="mx__xlab">{i}</div>)}
        </div>
        <div class="mx__xaxis" aria-hidden="true">Impacto</div>
      </div>

      <ul class="mx__legend">
        {(Object.entries(LVL_LABEL) as [Lvl, string][]).map(([code, label]) => (
          <li class="mx__lg">
            <span class={`mx__dot mx__cell--${code}`} aria-hidden="true"></span>
            <b>{code}</b> {label}
          </li>
        ))}
      </ul>
    </figure>

    <div class="mx__tablewrap">
      <table class="mx__table">
        <caption class="vh">Riesgos priorizados con nivel y decisión asociada</caption>
        <thead>
          <tr>
            <th scope="col">Cód.</th>
            <th scope="col">Riesgo</th>
            <th scope="col">P × I</th>
            <th scope="col">Nivel</th>
            <th scope="col">Decisión</th>
          </tr>
        </thead>
        <tbody>
          {riesgos.map((r) => {
            const lvl = levelAt(r.prob, r.impact);
            return (
              <tr>
                <td class="mx__td-id">{r.id}</td>
                <td>{r.name}</td>
                <td class="mx__td-pi">{r.prob} × {r.impact}</td>
                <td>
                  <span class={`mx__badge mx__cell--${lvl}`}>{lvl}</span>
                  <span class="mx__badge-l">{LVL_LABEL[lvl]}</span>
                </td>
                <td>{r.decision}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  /* Semáforo MAP/PETTERSEN — inviolable, los fondos no se tocan.
     El color del código sí se elige por contraste medido contra cada fondo:
     el código es el mecanismo accesible («el color nunca decide solo»), así
     que tiene que leerse. Ratios verificados (WCAG 2.2, texto normal ≥4.5):
       MB #16A34A · #0D1218 → 5.71:1
       B  #65A30D · #0D1218 → 6.09:1
       M  #D97706 · #0D1218 → 5.90:1
       A  #EA580C · #0D1218 → 5.28:1
       C  #DC2626 · #FFFFFF → 4.83:1  (con #0D1218 daba 3.89:1, falla) */
  .mx__cell--MB { background: var(--risk-very-low);  color: var(--risk-text); }
  .mx__cell--B  { background: var(--risk-low);       color: var(--risk-text); }
  .mx__cell--M  { background: var(--risk-medium);    color: var(--risk-text); }
  .mx__cell--A  { background: var(--risk-high);      color: var(--risk-text); }
  .mx__cell--C  { background: var(--risk-critical);  color: #fff; }

  .mx {
    margin: 56px 0 0;
    background: rgba(255, 255, 255, .04);
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 12px;
    padding: 32px;
  }
  .mx__cap { display: flex; flex-direction: column; gap: 6px; margin-bottom: 26px; }
  .mx__title { font: 700 20px/1.3 var(--font-display); color: #fff; }
  .mx__sub { font: 400 14px/1.4 var(--font-ui); color: rgba(255, 255, 255, .6); }

  .mx__wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    gap: 10px;
    align-items: center;
  }
  .mx__yaxis {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: center;
    font: 700 12px/1 var(--font-ui);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .55);
  }
  .mx__xaxis {
    grid-column: 2;
    padding-left: 28px;
    text-align: center;
    font: 700 12px/1 var(--font-ui);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .55);
  }
  .mx__grid {
    display: grid;
    grid-template-columns: 28px repeat(5, 1fr);
    gap: 6px;
  }
  .mx__ylab, .mx__xlab {
    font: 700 13px/1 var(--font-ui);
    color: rgba(255, 255, 255, .55);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mx__xlab { padding-top: 4px; }

  .mx__cell {
    position: relative;
    aspect-ratio: 1 / .62;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .mx__code { font: 800 13px/1 var(--font-ui); }
  .mx__chips { display: flex; gap: 5px; }
  /* Chip del riesgo: #fff sobre #0D1218 = 18,80:1 en cualquier celda. */
  .mx__chip {
    font: 800 13px/1 var(--font-ui);
    background: var(--risk-text);
    color: #fff;
    border-radius: 4px;
    padding: 5px 7px;
  }

  .mx__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 26px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid rgba(255, 255, 255, .12);
    list-style: none;
  }
  .mx__lg {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 400 13.5px/1 var(--font-ui);
    color: rgba(255, 255, 255, .72);
  }
  .mx__lg b { color: #fff; }
  .mx__dot { width: 14px; height: 14px; border-radius: 3px; display: block; }

  /* --- Tabla ---------------------------------------------------------- */
  .mx__tablewrap { margin-top: 32px; overflow-x: auto; }
  .mx__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }
  .mx__table th {
    text-align: left;
    font: 700 12px/1.4 var(--font-ui);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .55);
    padding: 0 16px 14px 0;
    border-bottom: 2px solid var(--gold-500);
  }
  .mx__table td {
    font: 400 15px/1.5 var(--font-ui);
    color: rgba(255, 255, 255, .84);
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, .10);
    vertical-align: top;
  }
  .mx__td-id { font-weight: 800; color: var(--gold-500); white-space: nowrap; }
  .mx__td-pi { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .mx__badge {
    display: inline-block;
    font: 800 12px/1 var(--font-ui);
    border-radius: 4px;
    padding: 6px 8px;
    margin-right: 8px;
  }
  .mx__badge-l { white-space: nowrap; }

  @media (max-width: 720px) {
    .mx { padding: 20px; margin-top: 40px; }
    .mx__cell { aspect-ratio: 1 / .8; flex-direction: column; gap: 4px; }
    .mx__code { font-size: 11px; }
    .mx__chip { font-size: 11px; padding: 4px 5px; }
    .mx__grid { grid-template-columns: 20px repeat(5, 1fr); gap: 4px; }
  }
</style>
