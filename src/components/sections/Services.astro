---
import Kicker from '../Kicker.astro';
import Icon from '../Icon.astro';

const servicios = [
  {
    n: '01', icon: 'shield',
    title: 'Gobierno de riesgos',
    body: 'Marco de riesgos no financieros, operacional, de modelo IA, ESG y reputacional. Apetito, KRI, exposición y madurez ante el comité.',
    tags: ['ISO 31000', 'COSO ERM', 'NFR'],
  },
  {
    n: '02', icon: 'building',
    title: 'Continuidad y ciberseguridad',
    body: 'BCM, resiliencia operacional y postura de ciberseguridad. Privacidad y cumplimiento normativo trazable, alineado a DORA y NIST CSF.',
    tags: ['ISO 22301', 'ISO 27001', 'DORA'],
  },
  {
    n: '03', icon: 'layers',
    title: 'Gobierno de TI y arquitectura',
    body: 'COBIT 2019, TOGAF e ITIL 4 para ordenar la función tecnológica. PMO, portafolio y transformación digital con criterio de inversión.',
    tags: ['COBIT 2019', 'TOGAF', 'ITIL 4'],
  },
  {
    n: '04', icon: 'cap',
    title: 'Formación ejecutiva',
    body: 'Programas para organizaciones —desde el directorio hasta la alta gerencia— a través de IBEE. Riesgo, gobierno y tecnología explicados para decidir, no para administrar.',
    tags: ['IBEE', 'Directorios', 'C-level'],
  },
] as const;
---

<section id="servicios" class="sec sec--soft">
  <div class="sec__in">
    <Kicker>Servicios</Kicker>
    <h2 class="h2" style="max-width:720px">Cuatro frentes, un mismo criterio de decisión.</h2>

    <div class="sv__grid">
      {servicios.map((s) => (
        <article class="sv__card">
          <div class="sv__top">
            <div class="sv__icon"><Icon name={s.icon} size={25} /></div>
            <span class="sv__n">{s.n}</span>
          </div>
          <h3 class="sv__t">{s.title}</h3>
          <p class="sv__b">{s.body}</p>
          <ul class="sv__tags">
            {s.tags.map((t) => <li class="sv__tag">{t}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .sv__grid {
    display: grid;
    gap: 24px;
    margin-top: 60px;
    grid-template-columns: repeat(2, 1fr);
  }
  .sv__card {
    background: #fff;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 38px;
    position: relative;
    overflow: hidden;
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
  }
  .sv__card:hover {
    border-color: var(--gold-500);
    box-shadow: 0 18px 40px -24px rgba(14, 30, 64, .35);
    transform: translateY(-3px);
  }
  .sv__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 22px;
  }
  .sv__icon {
    width: 50px;
    height: 50px;
    border-radius: 8px;
    background: var(--navy-900);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold-500);
  }
  .sv__n {
    font: 800 30px/1 var(--font-display);
    color: var(--neutral-200);
    letter-spacing: -.02em;
  }
  .sv__t { font: 700 22px/1.25 var(--font-display); color: var(--navy-900); margin: 0 0 12px; }
  .sv__b { font: 400 16px/1.62 var(--font-serif); color: var(--text-body); margin: 0 0 22px; }
  .sv__tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .sv__tag {
    font: 600 12.5px/1 var(--font-ui);
    letter-spacing: .02em;
    color: var(--text-context);
    background: var(--teal-50);
    border: 1px solid var(--teal-100);
    border-radius: 5px;
    padding: 7px 11px;
  }

  @media (max-width: 1024px) { .sv__grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    .sv__grid { gap: 18px; margin-top: 44px; }
    .sv__card { padding: 28px; }
  }
</style>
