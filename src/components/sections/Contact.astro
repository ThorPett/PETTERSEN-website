---
import Kicker from '../Kicker.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../data/site';

/**
 * Contacto — sin formulario.
 *
 * El formulario del template simulaba un envío exitoso («Mensaje registrado.
 * Respondo personalmente dentro de las 48 horas hábiles») y descartaba el
 * mensaje. Se elimina: Cal toma el flujo. Consecuencia: no hacen falta
 * Worker, Turnstile ni servicio de envío, y el sitio queda 100% estático.
 *
 * Cal por enlace directo, nunca embebido: el embed carga JS de terceros,
 * deja cookies y obliga a abrir script-src / frame-src / connect-src en las
 * cabeceras. Rompería la analítica sin cookies y el CSP.
 *
 * El enlace secundario apunta al perfil completo de Cal a propósito: ahí
 * viven los otros tipos de reunión. Es el calendario publicado.
 */
---

<section id="contacto" class="sec ct">
  <img src="/assets/isotipo-oro.svg" alt="" aria-hidden="true" class="ct__mark" />

  <div class="ct__in">
    <div>
      <Kicker onDark>Contacto</Kicker>
      <h2 class="h2 h2--dark" style="max-width:480px">Empecemos por la pregunta correcta.</h2>
      <p class="lead lead--dark" style="max-width:460px;margin-bottom:36px">
        Una conversación inicial para entender el contexto, el órgano de gobierno y la decisión
        que hay que sostener.
      </p>

      <div class="ct__links">
        <a href={`mailto:${SITE.email}`} class="ct__link">
          <span class="ct__ic"><Icon name="mail" size={20} /></span>{SITE.email}
        </a>
        <a href={SITE.linkedin} class="ct__link" target="_blank" rel="noopener">
          <span class="ct__ic"><Icon name="linkedin" size={20} /></span>LinkedIn · Mario Pettersen
        </a>
      </div>
    </div>

    <div class="ct__card">
      <div class="ct__cardhead">
        <span class="ct__ic"><Icon name="calendar" size={22} /></span>
        <h3 class="ct__cardt">Agenda abierta</h3>
      </div>
      <p class="ct__cardb">
        Elegí un horario directamente sobre mi calendario. Sin intercambio de correos para
        coordinar.
      </p>

      <a href={SITE.cal} class="btn btn--gold ct__btn" target="_blank" rel="noopener">
        Reservar una conversación inicial <Icon name="arrowRight" size={18} />
      </a>

      <a href={SITE.calPerfil} class="ct__alt" target="_blank" rel="noopener">
        ¿Otra duración? Ver disponibilidad completa <Icon name="arrowUpRight" size={15} />
      </a>
    </div>
  </div>
</section>

<style>
  .ct { background: var(--navy-900); overflow: hidden; }
  .ct__mark {
    position: absolute;
    left: -6%;
    top: -20%;
    height: 460px;
    opacity: .05;
    pointer-events: none;
  }
  .ct__in {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 128px 64px;
    display: grid;
    gap: 80px;
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .ct__links { display: flex; flex-direction: column; gap: 16px; }
  .ct__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    text-decoration: none;
    font: 600 16px/1 var(--font-ui);
  }
  .ct__link:hover { color: var(--gold-500); }
  .ct__ic { color: var(--gold-500); display: flex; flex: none; }

  .ct__card {
    background: rgba(255, 255, 255, .04);
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 12px;
    padding: 36px;
  }
  .ct__cardhead { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .ct__cardt { font: 700 22px/1.3 var(--font-display); color: #fff; margin: 0; }
  .ct__cardb {
    font: 400 16px/1.62 var(--font-serif);
    color: rgba(255, 255, 255, .78);
    margin: 0 0 28px;
  }
  .ct__btn { width: 100%; }
  .ct__alt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font: 600 14.5px/1.4 var(--font-ui);
    color: rgba(255, 255, 255, .72);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, .28);
    padding-bottom: 3px;
  }
  .ct__alt:hover { color: var(--gold-500); border-bottom-color: var(--gold-500); }

  @media (max-width: 1024px) {
    .ct__in { grid-template-columns: 1fr; gap: 48px; padding: 96px 48px; }
  }
  @media (max-width: 720px) {
    .ct__in { padding: 72px 24px; }
    .ct__card { padding: 24px; }
  }
</style>
