---
/**
 * Header fijo. Transparente sobre el hero, navy sólido al hacer scroll
 * (lo activa /js/site.js; sin JS queda navy sólido, que es legible igual).
 *
 * Las anclas se resuelven según la página: en la home son locales (#enfoque);
 * desde cualquier ruta interna —el blog cuando exista— apuntan a /#enfoque.
 * Sin esto, el header deja de funcionar apenas el sitio deja de ser una
 * sola página.
 */
import { NAV } from '../data/site';
import Icon from './Icon.astro';

interface Props { isHome?: boolean }
const { isHome = false } = Astro.props;

const href = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header class="hd" data-header>
  <div class="hd__in">
    <a href={isHome ? '#top' : '/'} class="hd__brand" aria-label="PETTERSEN, inicio">
      {/* Isotipo martillo (Mjölnir) en oro: variante aprobada por el DS para
          fondos navy. Va inline y no como <img> para que tome el token de
          color y escale sin request adicional. El trazado es el mismo de
          assets/isotipo-oro.svg. */}
      <svg class="hd__mark" viewBox="0 0 345 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path fill="currentColor" fill-rule="evenodd" d="M 128,48 L 128,79 L 135,80 L 146,85 L 152,92 L 156,105 L 156,138 L 151,167 L 143,196 L 135,214 L 122,233 L 106,248 L 81,262 L 56,268 L 50,268 L 48,270 L 40,289 L 37,318 L 75,319 L 112,327 L 131,335 L 156,353 L 188,353 L 213,335 L 223,330 L 246,323 L 278,318 L 306,318 L 304,290 L 295,269 L 266,263 L 248,255 L 236,247 L 217,227 L 201,197 L 193,169 L 189,147 L 187,112 L 190,96 L 193,90 L 201,83 L 215,79 L 215,48 Z M 104,17 L 104,111 L 130,112 L 130,140 L 125,167 L 111,202 L 92,223 L 69,236 L 49,242 L 36,243 L 27,254 L 19,270 L 15,284 L 13,347 L 71,350 L 96,355 L 111,360 L 129,370 L 146,386 L 197,386 L 208,375 L 225,364 L 259,352 L 283,349 L 330,348 L 329,285 L 318,256 L 309,244 L 272,235 L 248,220 L 231,199 L 217,161 L 213,130 L 214,112 L 240,111 L 240,17 Z"></path>
      </svg>
      {/* PNG, no SVG. El wordmark SVG del design system sigue siendo un <text>
          con font-family Barlow, no un trazado vectorizado: cargado por <img>
          el SVG queda aislado, no ve las @font-face de la página y el
          navegador cae a Arial. El PNG conserva el Barlow 900 real. Volver a
          SVG recién cuando el DS exporte el wordmark vectorizado. */}
      <img src="/assets/wordmark-blanco.png" alt="" width="162" height="26" />
    </a>

    <nav class="hd__nav" aria-label="Principal">
      {NAV.map((n) => (
        <a href={href(n.id)} class="hd__link">{n.label}</a>
      ))}
      <a href={href('contacto')} class="btn btn--gold btn--sm hd__cta">Agendar conversación</a>
    </nav>

    <button
      class="hd__burger"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="hd-mobile"
      data-burger
    >
      <span data-burger-open><Icon name="menu" size={26} /></span>
      <span data-burger-close hidden><Icon name="close" size={26} /></span>
    </button>
  </div>

  <div class="hd__mobile" id="hd-mobile" hidden data-mobile-menu>
    {NAV.map((n) => (
      <a href={href(n.id)} class="hd__mlink">{n.label}</a>
    ))}
    <a href={href('contacto')} class="btn btn--gold hd__mcta">Agendar conversación</a>
  </div>
</header>

<style>
  .hd {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgba(7, 18, 40, .92);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, .10);
    transition: background .3s ease, border-color .3s ease;
  }
  /* Sólo se vuelve transparente si el JS confirmó que estamos arriba.
     El estado por defecto es el sólido: sin JS el header sigue legible. */
  .hd[data-top='1'] {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .hd__in {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Lockup de marca: isotipo oro + wordmark blanco, ambos 20% más grandes
     que la primera versión (isotipo 28 → 34 px, wordmark 22 → 26 px). */
  .hd__brand { display: flex; align-items: center; gap: 12px; }
  .hd__mark { height: 34px; width: auto; display: block; color: var(--gold-500); flex: none; }
  .hd__brand img { height: 26px; width: auto; display: block; }

  @media (max-width: 480px) {
    .hd__brand { gap: 9px; }
    .hd__mark { height: 28px; }
    .hd__brand img { height: 21px; }
  }

  .hd__nav { display: flex; align-items: center; gap: 30px; }

  .hd__link {
    font: 600 14.5px/1 var(--font-ui);
    letter-spacing: .01em;
    color: rgba(255, 255, 255, .78);
    text-decoration: none;
    transition: color .2s ease;
    white-space: nowrap;
  }
  .hd__link:hover { color: var(--gold-500); }

  .hd__burger {
    display: none;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 6px;
  }

  .hd__mobile {
    background: rgba(7, 18, 40, .98);
    border-top: 1px solid rgba(255, 255, 255, .10);
    padding: 12px 24px 24px;
    flex-direction: column;
    gap: 4px;
  }
  .hd__mobile:not([hidden]) { display: flex; }

  .hd__mlink {
    font: 600 16px/1 var(--font-ui);
    color: rgba(255, 255, 255, .85);
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, .08);
  }
  .hd__mcta { margin-top: 14px; }

  @media (max-width: 1024px) {
    .hd__in { padding: 14px 24px; }
    .hd__nav { display: none; }
    .hd__burger { display: flex; }
  }
</style>
