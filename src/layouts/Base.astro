---
/**
 * Layout base — chrome único del sitio.
 *
 * Existe desde la v1 aunque la v1 tenga una sola página: cuando se publique
 * /criterio, los artículos consumen este mismo layout sin refactorizar head,
 * header ni footer. Esa es la reserva estructural del blog.
 */
import { SITE } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  /** true en la home: la navegación usa anclas locales (#enfoque). */
  isHome?: boolean;
  /** Ruta canónica sin dominio, p. ej. '/criterio/mi-articulo'. */
  path?: string;
  /** Imagen OG propia; por defecto la institucional. */
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = SITE.titulo,
  description = SITE.descripcion,
  isHome = false,
  path = '/',
  ogImage = '/assets/og-pettersen.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const ogAbs = new URL(ogImage, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mario A. Pettersen',
  url: SITE.url,
  jobTitle: 'Consultor senior y educador ejecutivo',
  description: SITE.descripcion,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Buenos Aires',
    addressCountry: 'AR',
  },
  email: `mailto:${SITE.email}`,
  sameAs: [SITE.linkedin, SITE.ibee],
  knowsAbout: [
    'Gobierno de riesgos',
    'Riesgo no financiero',
    'ISO 31000',
    'ISO 22301',
    'ISO 27001',
    'COBIT 2019',
    'COSO ERM',
    'NIST CSF',
    'DORA',
    'Continuidad de negocio',
    'Gobierno de TI',
  ],
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0E1E40" />

    <!-- Fuentes críticas: el resto carga por font-display: swap -->
    <link
      rel="preload"
      href="/fonts/barlow-normal-800-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-normal-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PETTERSEN" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <Footer isHome={isHome} />
    <script src="/js/site.js" is:inline defer></script>
  </body>
</html>
